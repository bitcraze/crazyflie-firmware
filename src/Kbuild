# The Simmyflie (CONFIG_PLATFORM_SIM) builds everything that is not excluded
# below, and its own sources in src/sim/src/. See
# docs/development/simmyflie/index.md.
ifeq ($(CONFIG_PLATFORM_SIM),y)
# Some log and param groups are declared in more than one file. On a 64-bit
# host, a partial link pads between same-named sections and corrupts the log
# and param tables. --unique keeps them apart until the final link; see the
# -malign-data=abi comment in the Makefile.
EXTRA_LDFLAGS += -Wl,--unique=.log.* -Wl,--unique=.param.*
endif

ifneq ($(CONFIG_PLATFORM_SIM),y)
obj-y += deck/
obj-y += drivers/
endif
obj-y += hal/
ifneq ($(CONFIG_PLATFORM_SIM),y)
obj-y += init/
obj-y += lib/
endif
obj-y += modules/
ifneq ($(CONFIG_PLATFORM_SIM),y)
obj-y += platform/
endif
obj-y += utils/
obj-$(CONFIG_PLATFORM_SIM) += sim/src/
