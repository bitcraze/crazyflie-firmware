CONFIG_PLATFORM_SIM=y
CONFIG_CROSS_COMPILE=""

# Phase 4.9: CONFIG_ESTIMATOR_KALMAN_ENABLE now reverts to mainline's own
# default (y), matching real hardware -- see
# dev/implementation-plan-phase-4.md's 4.9 section for the dependency sweep
# showing the EKF's only hardware coupling (estimator_kalman.c's #include
# "deck.h", used solely for deckGetRequiredKalmanEstimatorAttitudeReversionOff())
# is solved the same way 4.8 solved motors.h/pm.h/platform.h: include-path
# shadowing (src/config/sim/hw_shims/deck.h). ESTIMATOR_AUTO_SELECT stays the
# default estimator *choice*: with no decks present it falls back to
# DEFAULT_ESTIMATOR (Complementary) in estimator.c, same as real hardware out
# of the box -- selecting Kalman is a `make menuconfig` -> "Default
# estimator" -> "Kalman estimator" choice, not a sim-specific override.
#
# DECK_FLOW/DECK_LIGHTHOUSE/DECK_LOCO stay disabled below regardless (no deck
# bus in sim -- i2cdevInit() is a no-op stub, see i2cdev_sim.c/Phase 4.0);
# each also `select`s ESTIMATOR_KALMAN_ENABLE, but that's moot now that the
# flag defaults to y anyway.
CONFIG_DECK_FLOW=n
CONFIG_DECK_LIGHTHOUSE=n
CONFIG_DECK_LOCO=n

# Phase 4.8: no uSD card in sim -- stabilizer.c's #ifdef CONFIG_DECK_USD
# block calls usddeck.c's logging functions, another deck driver not built
# under PLATFORM_SIM (usddeck.c itself is real-hardware SPI/FS code, out of
# scope here). Default y on real hardware, so needs an explicit override.
CONFIG_DECK_USD=n
